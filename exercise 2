        "ax.coastlines()\n",
        "\n",
        "# Add major ocean labels (Atlantic, Pacific, etc.)\n",
        "\n",
        "# Atlantic Ocean\n",
        "ax.text(-30, 0, 'Atlantic Ocean', transform=ccrs.PlateCarree(),\n",
        "        horizontalalignment='center', verticalalignment='center',\n",
        "        fontsize=10, color='blue', weight='bold')\n",
        "\n",
        "# Pacific Ocean (left side)\n",
        "ax.text(-140, 0, 'Pacific Ocean', transform=ccrs.PlateCarree(),\n",
        "        horizontalalignment='center', verticalalignment='center',\n",
        "        fontsize=10, color='blue', weight='bold')\n",
        "\n",
        "# Pacific Ocean (right side, for wrap-around)\n",
        "ax.text(160, 0, 'Pacific Ocean', transform=ccrs.PlateCarree(),\n",
        "        horizontalalignment='center', verticalalignment='center',\n",
        "        fontsize=10, color='blue', weight='bold')\n",
        "\n",
        "# Indian Ocean\n",
        "ax.text(80, -20, 'Indian Ocean', transform=ccrs.PlateCarree(),\n",
        "        horizontalalignment='center', verticalalignment='center',\n",
        "        fontsize=10, color='blue', weight='bold')\n",
        "\n",
        "# Arctic Ocean\n",
        "ax.text(0, 80, 'Arctic Ocean', transform=ccrs.PlateCarree(),\n",
        "        horizontalalignment='center', verticalalignment='center',\n",
        "        fontsize=10, color='blue', weight='bold')\n",
        "\n",
        "# Add an arrow saying \"We are here\" that is pointing to Charlotte, North Carolina\n",
        "ax.annotate(\n",
        "    'We are here',\n",
        "    xy=(charlotte_lon, charlotte_lat),       # Point to annotate\n",
        "    xytext=(charlotte_lon + 20, charlotte_lat + 20), # Text position (adjusted for better visibility)\n",
        "    arrowprops=dict(facecolor='red', shrink=0.05), # Arrow properties\n",
        "    horizontalalignment='right',\n",
        "    verticalalignment='bottom',\n",
